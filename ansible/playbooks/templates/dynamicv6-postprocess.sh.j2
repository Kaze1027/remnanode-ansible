#!/bin/bash
# DynamicV6 容错回退脚本 — 部署到所有 Aether VM
# 逻辑: 优先使用最后一个下发的动态IPv6; 若网关二层不可达则回退到 VM 原生 IPv6
# 由 systemd timer 每 2 分钟调用一次 (ExecStartPost)

IFACE="{{ dynamicv6_iface | default('eth0') }}"
STATE_FILE="{{ dynamicv6_state_file | default('/var/lib/dynamicv6/client-eth0.state') }}"

# --- 自动探测: 原生 IPv6 (2602: 开头) 作为回退时使用的源地址 ---
NATIVE_SRC="$(ip -6 addr show "$IFACE" | grep -oP '2602:[\da-f:]+(?=/)' | head -n1)"
[ -z "$NATIVE_SRC" ] && NATIVE_SRC="$(ip -6 addr show "$IFACE" | grep -oP '2602:[0-9a-f:]+' | head -n1)"

# --- 自动探测: 可达的链路本地路由器网关 (已解析MAC且非FAILED的 fe80: router) ---
LLGW="$(ip -6 neigh show dev "$IFACE" 2>/dev/null | awk '$1 ~ /^fe80:/ && $0 ~ /router/ && $0 !~ /FAILED/ {print $1}' | head -n1)"
[ -z "$LLGW" ] && LLGW="{{ dynamicv6_llgw | default('') }}"

if [[ -z "$NATIVE_SRC" || -z "$LLGW" ]]; then
  echo "[dp] WARN: cannot determine native_src=$NATIVE_SRC llgw=$LLGW; keeping as-is" >&2
fi

# --- 清理脚本侧遗留的备用默认路由 (metric>=2048) ---
for m in 2048 2049 2050; do ip -6 route del default dev "$IFACE" metric "$m" 2>/dev/null; done

# --- 1) 优先最后一个动态 IPv6 ---
LAST_CIDR="$(jq -r '.ipv6_cidrs[-1] // empty' "$STATE_FILE" 2>/dev/null)"
LAST_GW="$(jq -r '.gateways[-1] // empty' "$STATE_FILE" 2>/dev/null)"
LAST_ADDR="${LAST_CIDR%/*}"
DYN_OK=0
if [[ -n "$LAST_GW" && -n "$LAST_ADDR" && -n "$NATIVE_SRC" ]]; then
  ip -6 route replace default via "$LAST_GW" dev "$IFACE" src "$LAST_ADDR" metric 1024 mtu 1280 2>/dev/null
  # 网关二层可达性检测 (NDP 邻居解析成功且能 ping 通)
  if ip -6 route get "$LAST_GW" >/dev/null 2>&1 && ip -6 neigh get "$LAST_GW" >/dev/null 2>&1; then
    if ping6 -c 1 -W 2 "$LAST_GW%${IFACE}" >/dev/null 2>&1; then
      DYN_OK=1
      echo "[dp] last dyn OK: $LAST_ADDR via $LAST_GW"
    fi
  fi
fi

# --- 2) 失败则回退 VM 原生 IPv6 ---
if [[ "$DYN_OK" != "1" ]]; then
  if [[ -n "$NATIVE_SRC" && -n "$LLGW" ]]; then
    ip -6 route replace default via "$LLGW" dev "$IFACE" src "$NATIVE_SRC" metric 1024 mtu 1280
    echo "[dp] fallback native: $NATIVE_SRC via $LLGW"
  else
    echo "[dp] WARN: unable to set native fallback route" >&2
  fi
fi

echo "[dp] current default:"
ip -6 route show default metric 1024
